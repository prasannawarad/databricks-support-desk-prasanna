# Local development only. Copy to .env, fill in, then: source .env
# PGUSER is YOUR Databricks email locally, the service principal client ID when deployed.
export PGHOST="<ENDPOINT_HOST>"
export PGDATABASE="databricks_postgres"
export PGUSER="you@company.com"
export PGPORT="5432"
export PGSSLMODE="require"
export ENDPOINT_NAME="projects/<project-id>/branches/<branch-id>/endpoints/<endpoint-id>"
